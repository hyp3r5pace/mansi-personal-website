# Contact form — email delivery (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@yourdomain.com
CONTACT_FROM_EMAIL="Bubu Studio <hello@yourdomain.com>"

# Contact form — bot protection (Cloudflare Turnstile)
# Get keys: https://dash.cloudflare.com/?to=/:account/turnstile
# Site key is public (shipped to the browser); secret stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# WhatsApp click-to-chat button (public). E.164 digits, no leading "+".
# e.g. 919876543210 for +91 98765 43210. Leave empty to hide the button.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─────────────────────────────────────────────────────────────────────
# Studio admin — Behance project importer (/admin). One-time setup; the
# admin only ever signs in with the password. Without these, the importer
# falls back to writing locally (dev only).

# Owner login. ADMIN_PASSWORD unlocks /admin; SESSION_SECRET must be 32+ chars.
ADMIN_PASSWORD=
SESSION_SECRET=

# Claude vision — drafts alt text, captions, cover, palette on import.
ANTHROPIC_API_KEY=

# Vercel Blob — stores imported project images (keeps the repo lean).
BLOB_READ_WRITE_TOKEN=

# GitHub — publish commits the project MDX to the repo (triggers redeploy).
# Fine-grained token with Contents: read/write on this repo.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main
